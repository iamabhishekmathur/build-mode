{
  "permissions": {
    "allow": [
      "mcp__stagecraft",
      "Bash(npx tsc:*)",
      "Bash(npx --no stagecraft:*)"
    ],
    "additionalDirectories": [
      "../acme-ui",
      "../acme-admin",
      "../acme-api"
    ]
  },
  "enabledMcpjsonServers": [
    "stagecraft"
  ],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "npx --no stagecraft hook post-edit"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "npx --no stagecraft hook pre-bash"
          }
        ]
      }
    ]
  }
}
