    "@openfeature/server-sdk": { "optional": true }
  },
  "dependencies": {
    "@stagecraft/core": "0.1.0",
    "@stagecraft/runtime": "0.1.0"
  },
  "devDependencies": {
    "@openfeature/core": "^1.9.0",
    "@openfeature/web-sdk": "^1.6.0",
    "@openfeature/server-sdk": "^1.18.0",
    "launchdarkly-js-client-sdk": "^3.9.0",
    "@launchdarkly/js-client-sdk": "^4.14.0",
    "@growthbook/growthbook": "^1.6.0",
    "unleash-proxy-client": "^3.7.0"
  }
