{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stagecraft.dev/schema/scenario.v1.json",
  "title": "Stagecraft scenario v1",
  "description": "A saved setup: persona, states, flags, variants, faults, mock DB, URL. Stored in stagecraft/scenarios/*.json.",
  "type": "object",
  "required": ["name"],
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "extends": { "type": "string", "description": "Base scenario name. Fields here override it; maps merge; db patches stack." },
    "persona": { "type": "string" },
    "states": { "type": "object", "additionalProperties": { "type": "string" } },
    "flags": { "type": "object" },
    "variants": { "type": "object", "additionalProperties": { "type": "string" } },
    "faults": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["endpoint"],
        "properties": { "endpoint": { "type": "string" }, "latencyMs": { "type": "number" }, "status": { "type": "integer" }, "timeout": { "type": "boolean" }, "body": {} }
      }
    },
    "url": { "type": "string" },
    "viewport": { "type": "object", "properties": { "width": { "type": "integer" }, "height": { "type": "integer" } } },
    "theme": { "enum": ["light", "dark"] },
    "locale": { "type": "string" },
    "db": { "type": "object", "description": "Extra DB patch on top of seed + states." },
    "dbSnapshot": { "description": "Full mock DB. Wins over seed + states + db." },
    "tape": { "type": "object", "required": ["id"], "properties": { "id": { "type": "string" }, "at": { "type": "string" }, "autoplay": { "type": "boolean" } } }
  },
  "additionalProperties": false
}
